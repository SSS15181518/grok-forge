# Providers are tried in order: if #1 is rate-limited (HTTP 429) or down, #2 is used, and so on.
# All of them speak the OpenAI-compatible API and serve open-weight models.
# Model ids change over time - check each provider's models page and adjust.

# 1) Groq - free tier, no credit card, very fast. Key: https://console.groq.com/keys
LLM_1_NAME=groq
LLM_1_BASE_URL=https://api.groq.com/openai/v1
LLM_1_API_KEY=gsk_xxx
LLM_1_MODEL=openai/gpt-oss-120b

# 2) Cerebras - free tier with a generous daily token allowance. Key: https://cloud.cerebras.ai
# LLM_2_NAME=cerebras
# LLM_2_BASE_URL=https://api.cerebras.ai/v1
# LLM_2_API_KEY=csk_xxx
# LLM_2_MODEL=gpt-oss-120b

# 3) OpenRouter - free ":free" model variants with a daily request cap. Key: https://openrouter.ai/keys
# LLM_3_NAME=openrouter
# LLM_3_BASE_URL=https://openrouter.ai/api/v1
# LLM_3_API_KEY=sk-or-xxx
# LLM_3_MODEL=openai/gpt-oss-120b:free
# LLM_3_JSON_MODE=false

# Few-shot examples sent per request (retrieved by similarity) and automatic repair rounds
FEW_SHOT_K=8
REPAIR_ROUNDS=2

# Set to false on a public deployment so visitors can't write to data/examples.jsonl
ALLOW_SAVE_EXAMPLES=true

# Optional: second-opinion validation with Elasticsearch's grok (same engine as Logstash)
# ES_URL=https://localhost:9200
# ES_API_KEY=base64-id:key
# ES_VERIFY_TLS=false
